# Copy to .env.web.local for local production-web builds.
# In Cloudflare Pages, set these in the production build environment.
VITE_API_BASE_URL=https://api.campusmindapp.com
VITE_AMAP_KEY=
VITE_AMAP_SERVICE_HOST=https://campusmindapp.com/_AMapService
VITE_AMAP_SECURITY_CODE=
# Set AMAP_SECURITY_CODE as a Pages Functions Secret, never as VITE_*.
